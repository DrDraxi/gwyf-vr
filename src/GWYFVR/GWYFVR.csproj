<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>GWYFVR</AssemblyName>
    <RootNamespace>GWYFVR</RootNamespace>
    <Description>VR mod for Gamble With Your Friends</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.*" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game and engine assemblies are referenced from the local install and never shipped. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ManagedDir)\UnityEngine.dll;$(ManagedDir)\UnityEngine.CoreModule.dll;$(ManagedDir)\UnityEngine.XRModule.dll;$(ManagedDir)\UnityEngine.VRModule.dll;$(ManagedDir)\UnityEngine.SubsystemsModule.dll;$(ManagedDir)\UnityEngine.UI.dll;$(ManagedDir)\UnityEngine.UIModule.dll;$(ManagedDir)\UnityEngine.IMGUIModule.dll;$(ManagedDir)\UnityEngine.InputLegacyModule.dll;$(ManagedDir)\UnityEngine.PhysicsModule.dll;$(ManagedDir)\UnityEngine.TextRenderingModule.dll;$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll;$(ManagedDir)\UnityEngine.ImageConversionModule.dll;$(ManagedDir)\Unity.InputSystem.dll;$(ManagedDir)\Unity.RenderPipelines.Universal.Runtime.dll;$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll;$(ManagedDir)\Unity.TextMeshPro.dll;$(ManagedDir)\Mirror.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RuntimeDepsDir)\Unity.XR.OpenXR.dll;$(RuntimeDepsDir)\Unity.XR.Management.dll;$(RuntimeDepsDir)\Unity.XR.CoreUtils.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
