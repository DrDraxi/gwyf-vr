<Project>
  <PropertyGroup>
    <!-- Override in GWYFVR.props.user or with -p:GameDir=... if the game lives elsewhere -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gamble With Your Friends</GameDir>
    <ManagedDir>$(GameDir)\Gamble With Your Friends_Data\Managed</ManagedDir>
    <RuntimeDepsDir>$(MSBuildThisFileDirectory)lib\RuntimeDeps</RuntimeDepsDir>
    <LangVersion>latest</LangVersion>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)GWYFVR.props.user" Condition="Exists('$(MSBuildThisFileDirectory)GWYFVR.props.user')" />
</Project>
